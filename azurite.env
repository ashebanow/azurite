# azurite image build parameters (loaded by the Justfile recipes)

# output image name, usually same as repo name
IMAGE_NAME=azurite

# your github username/organisation
REPO_ORGANIZATION="ashebanow"

IMAGE_DESC="Azurite: Bazzite with Niri and Dank Material Shell (DMS)"
IMAGE_KEYWORDS="bootc,ublue,universal-blue"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
